def send_telegram(message: str):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": TELEGRAM_ID, "text": message, "parse_mode": "HTML"}
    try:
        requests.post(url, json=payload, timeout=10)
    except Exception as e:
        print(f"[Telegram] Ошибка отправки: {e}")


def get_hot_tickers():
    url = "https://api.bybit.com/v5/market/tickers?category=linear"

    for attempt in range(1, RETRIES + 1):
        try:
            r = requests.get(url, headers=HEADERS, timeout=15)
            if r.status_code != 200:
                print(f"[get_hot_tickers] HTTP {r.status_code}, попытка {attempt}/{RETRIES}")
                time.sleep(RETRY_DELAY)
                continue

            data = r.json()
            if data.get("retCode") != 0:
                print(f"[get_hot_tickers] retCode={data.get('retCode')}, попытка {attempt}/{RETRIES}")
                time.sleep(RETRY_DELAY)
                continue

            qualified = []
            for item in data["result"]["list"]:
                symbol = item.get("symbol", "")
                if not symbol.endswith("USDT"):
                    continue

                price24h = float(item.get("prevPrice24h", 0) or 0)
                last = float(item.get("lastPrice", 0) or 0)
                turnover = float(item.get("turnover24h", 0) or 0)

                if price24h <= 0 or turnover < MIN_TURNOVER:
                    continue

                change = round((last - price24h) / price24h * 100, 2)
                if change >= MIN_CHANGE_24H:
                    qualified.append({
                        "symbol": symbol,
                        "change_24h": change,
                        "turnover": turnover
                    })
            return qualified

        except Exception as e:
            print(f"[get_hot_tickers] Исключение: {e}, попытка {attempt}/{RETRIES}")
            time.sleep(RETRY_DELAY)

    bot_status["last_error"] = f"get_hot_tickers failed at {datetime.now()}"
    return []


def get_candles(symbol: str):
    url = "https://api.bybit.com/v5/market/kline"
    params = {"category": "linear", "symbol": symbol, "interval": INTERVAL, "limit": CANDLES}

    for attempt in range(1, RETRIES + 1):
        try:
            r = requests.get(url, params=params, headers=HEADERS, timeout=10)
            if r.status_code != 200:
                time.sleep(1)
                continue

            data = r.json()
            if data.get("retCode") != 0:
                return None

            candles = data["result"]["list"]
            if not candles:
                return None

            df = pd.DataFrame(candles, columns=["time", "open", "high", "low", "close", "volume", "turnover"])
            df = df.astype({"open": "float", "high": "float", "low": "float", "close": "float", "volume": "float"})
            return df.iloc[::-1].reset_index(drop=True)

        except Exception:
            time.sleep(1)

    return None


def calc_index_series(df: pd.DataFrame):
    """Композитный индекс: RSI + Stoch%K + ROSC + WPR + %Rank + MFI + MACD + JAP,
    по образцу индикатора INTELLECT_city - index inside %."""
    try:
        close = df["close"]
        high = df["high"]
        low = df["low"]
        volume = df["volume"]
        n = 14

        delta = close.diff()
        gain = delta.clip(lower=0).rolling(n).mean()
        loss = (-delta.clip(upper=0)).rolling(n).mean()
        rsi = 100 - (100 / (1 + gain / loss.replace(0, np.nan)))

        low_n = low.rolling(n).min()
        high_n = high.rolling(n).max()
        stoch = 100 * (close - low_n) / (high_n - low_n).replace(0, np.nan)
        wpr = 100 + (100 * (close - high_n) / (high_n - low_n).replace(0, np.nan))

        hlc3 = (high + low + close) / 3
        mf = hlc3 * volume
        pos_mf = mf.where(hlc3 > hlc3.shift(1), 0).rolling(n).sum()
        neg_mf = mf.where(hlc3 < hlc3.shift(1), 0).rolling(n).sum()
        mfi = 100 - (100 / (1 + pos_mf / neg_mf.replace(0, np.nan)))

        idx_s = pd.Series(range(len(close)), index=close.index)
        rosc = ((close.rolling(n).corr(idx_s) + 1) / 2) * 100
        rank = close.rolling(100).apply(lambda x: pd.Series(x).rank(pct=True).iloc[-1] * 100)

        ema12 = close.ewm(span=12).mean()
        ema26 = close.ewm(span=26).mean()
        macd = ema12 - ema26
        sig = macd.ewm(span=9).mean()
        diff = macd - sig
        dmax = diff.abs().rolling(100).max().replace(0, np.nan)
        macd_n = 50 + (diff / dmax) * 50

        body = (close - df["open"]).abs()
        rng = (high - low).replace(0, np.nan)
        jap = pd.Series(np.where(close > df["open"], (body / rng) * 100, (1 - (body / rng)) * 100), index=close.index)

        composite = (rsi + stoch + rosc + wpr + rank + mfi + macd_n + jap) / 8
        return composite
    except Exception as e:
        print(f"[calc_index_series] Ошибка: {e}")
        return None


def check_pair(item: dict):
    symbol = item["symbol"]
    df = get_candles(symbol)
    if df is None or len(df) < 150:
        return None

    index_series = calc_index_series(df)
    if index_series is None:
        return None

    idx_current = index_series.iloc[-1]
    if pd.isna(idx_current):
        return None
    idx_current = round(idx_current, 1)
    price = df["close"].iloc[-1]

    if not (ZONE_LOW <= idx_current <= ZONE_HIGH):
        return None

    recent_idx = index_series.iloc[-(PEAK_LOOKBACK + 1):-1]
    peak_mask = (recent_idx >= PEAK_MIN) & (recent_idx <= PEAK_MAX)
    if not peak_mask.any():
        return None

    peak_value = recent_idx[peak_mask].max()
    last_peak_pos = recent_idx[peak_mask].index[-1]
    candles_ago = len(df) - 1 - last_peak_pos

    if idx_current >= peak_value:
        return None

    return {
        "symbol": symbol,
        "price": price,
        "idx_current": idx_current,
        "peak_value": round(peak_value, 1),
        "candles_ago": candles_ago,
        "change_24h": f"+{item['change_24h']}%",
        "turnover": f"${round(item['turnover'] / 1_000_000, 1)}M"
    }


def listen_commands():
    while True:
        try:
            url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/getUpdates"
            params = {"offset": bot_status["last_update_id"] + 1, "timeout": 20}
            r = requests.get(url, params=params, timeout=25)
            updates = r.json().get("result", [])
            for upd in updates:
                bot_status["last_update_id"] = upd["update_id"]
                text = upd.get("message", {}).get("text", "")
                if text == "/status":
                    uptime = datetime.now() - bot_status["start_time"]
                    h = uptime.seconds // 3600
                    m = (uptime.seconds % 3600) // 60
                    err_line = f"\n⚠️ Последняя ошибка API: {bot_status['last_error']}" if bot_status["last_error"] else ""
                    send_telegram(
                        f"✅ <b>Бот работает! (ТФ 30м)</b>\n\n"
                        f"⏱ Аптайм: {h}ч {m}мин\n"
                        f"🔄 Циклов: {bot_status['cycles_done']}\n"
                        f"📊 Горячих пар: {bot_status['pairs_checked']}/{bot_status['total_pairs']}\n"
                        f"🚀 Сигналов отправлено: {bot_status['signals_sent']}\n"
                        f"💹 Фильтры: оборот ${MIN_TURNOVER // 1_000_000}M+ | рост +{MIN_CHANGE_24H}%+\n"
                        f"🕐 Последняя проверка: {bot_status['last_check'] or 'ещё не было'}"
                        f"{err_line}"
                    )
        except Exception as e:
            print(f"[listen_commands] {e}")
            time.sleep(5)


def main():
    threading.Thread(target=listen_commands, daemon=True).start()
    send_telegram(
        "🚀 <b>Бот запущен (ТФ 30 минут)!</b>\n\n"
        "• Шаг 1: Оборот $5M+ И рост +20% за 24ч\n"
        "• Шаг 2: Пик индекса 92-99% (за 5.5 ч)\n"
        "• Шаг 3: Откат в зону 70-79%\n"
        "• Шаг 4: Сигнал в Telegram"
    )

    alerted = {}

    while True:
        now = datetime.now().strftime("%H:%M")
        start = time.time()

        hot_pairs = get_hot_tickers()
        bot_status["total_pairs"] = len(hot_pairs)
        print(f"[{now}] Отобрано горячих пар: {len(hot_pairs)}")

        if not hot_pairs:
            print("⚠️ Пустой список пар (проблема с API?), короткая пауза перед повтором.")
            time.sleep(60)
            continue

        checked = 0
        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
            futures = {executor.submit(check_pair, item): item for item in hot_pairs}
            for future in as_completed(futures):
                try:
                    result = future.result()
                except Exception as e:
                    print(f"[check_pair] Ошибка в потоке: {e}")
                    result = None

                checked += 1
                bot_status["pairs_checked"] = checked

                if result is None:
                    continue

                symbol = result["symbol"]

                if symbol in alerted and alerted[symbol] <= ZONE_HIGH:
                    continue

                msg = (
                    f"🚀 <b>ПАМП СИГНАЛ — LONG (Откат, ТФ 30м)</b>\n\n"
                    f"Монета: <b>{symbol}</b>\n"
                    f"Рост 24ч: <b>{result['change_24h']}</b>\n"
                    f"Оборот 24ч: <b>{result['turnover']}</b>\n\n"
                    f"Пик индекса: <b>{result['peak_value']}%</b>\n"
                    f"Текущий индекс: <b>{result['idx_current']}%</b>\n"
                    f"Пик был: <b>{result['candles_ago']} свечи назад</b>\n"
                    f"Текущая цена: <b>{result['price']}</b>\n\n"
                    f"⏱ Таймфрейм: 30 минут"
                )
                send_telegram(msg)
                bot_status["signals_sent"] += 1
                alerted[symbol] = result["idx_current"]
                print(f"🚀 СИГНАЛ: {symbol} (Индекс: {result['idx_current']}%)")

        elapsed = round(time.time() - start, 1)
        bot_status["last_check"] = datetime.now().strftime("%H:%M:%S")
        bot_status["cycles_done"] += 1
        print(f"✅ Проверка завершена за {elapsed} сек. Пауза {SLEEP_MIN} мин...\n")
        time.sleep(SLEEP_MIN * 60)


if __name__ == "__main__":
    main()
